# ── Frontend environment variables ──────────────────────────────────────────
# Copy this file to .env and fill in the values.
#
# VITE_API_BASE is baked into the JS bundle at build time by Vite.
# Set this in your Vercel project's Environment Variables dashboard
# (Settings → Environment Variables) rather than committing a .env file.
#
# Local development (default — no .env file needed):
#   VITE_API_BASE=http://localhost:8000/api/v1
#
# Production (Railway public URL — NOT the .railway.internal hostname,
# which is only reachable inside Railway's private network):
#   VITE_API_BASE=https://<your-service>.up.railway.app/api/v1

VITE_API_BASE=http://localhost:8000/api/v1
